---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const codeBlock = "border border-[#ebebeb] bg-[#0d0d0d] text-[#e5e5e5] rounded-[10px] p-4 text-[13px] font-mono leading-[20px] overflow-x-auto";

const languages = [
  {
    key: 'http',
    label: 'HTTP',
    auth: `Authorization: Bearer webpninja_live_<your_key>`,
    compress: `curl -X POST https://api.webpninja.com/api/v1/compress \\
  -H "Authorization: Bearer webpninja_live_your_key" \\
  -F "file=@photo.png" \\
  -F "format=webp" \\
  -F "quality=75" \\
  --output photo.webp`,
  },
  {
    key: 'node',
    label: 'Node.js',
    install: `npm install @webpninja/sdk`,
    sdkPublishing: true,
    auth: `const client = new WebPNinja("webpninja_live_your_key");
// or: const client = new WebPNinja(); // reads WEBPNINJA_API_KEY`,
    compress: `import { WebPNinja } from "@webpninja/sdk";

const client = new WebPNinja("webpninja_live_your_key");

await client.compressToFile("photo.png", "photo.webp", {
  format: "webp",
  quality: 75,
});`,
  },
  {
    key: 'python',
    label: 'Python',
    install: `pip install webpninja`,
    auth: `client = WebPNinja("webpninja_live_your_key")
# or: client = WebPNinja()  # reads WEBPNINJA_API_KEY`,
    compress: `from webpninja import WebPNinja

client = WebPNinja("webpninja_live_your_key")

client.compress_to_file("photo.png", "photo.webp", format="webp", quality=75)`,
  },
  {
    key: 'ruby',
    label: 'Ruby',
    install: `gem install webpninja`,
    comingSoon: true,
    auth: `request["Authorization"] = "Bearer webpninja_live_your_key"`,
    compress: `require "net/http"
require "uri"

uri = URI("https://api.webpninja.com/api/v1/compress")
request = Net::HTTP::Post.new(uri)
request["Authorization"] = "Bearer webpninja_live_your_key"
request.set_form(
  [
    ["file", File.open("photo.png"), { filename: "photo.png" }],
    ["format", "webp"],
    ["quality", "75"],
  ],
  "multipart/form-data"
)

response = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) do |http|
  http.request(request)
end

raise response.body unless response.is_a?(Net::HTTPSuccess)

File.binwrite("photo.webp", response.body)`,
  },
  {
    key: 'php',
    label: 'PHP',
    install: `composer require webpninja/webpninja`,
    comingSoon: true,
    auth: `"Authorization: Bearer webpninja_live_your_key"`,
    compress: `<?php
$ch = curl_init("https://api.webpninja.com/api/v1/compress");

curl_setopt_array($ch, [
    CURLOPT_POST => true,
    CURLOPT_RETURNTRANSFER => true,
    CURLOPT_HTTPHEADER => ["Authorization: Bearer webpninja_live_your_key"],
    CURLOPT_POSTFIELDS => [
        "file" => new CURLFile("photo.png"),
        "format" => "webp",
        "quality" => "75",
    ],
]);

$result = curl_exec($ch);
$status = curl_getinfo($ch, CURLINFO_HTTP_CODE);
curl_close($ch);

if ($status !== 200) {
    throw new Exception($result);
}

file_put_contents("photo.webp", $result);`,
  },
  {
    key: 'java',
    label: 'Java',
    install: `<dependency>
  <groupId>com.webpninja</groupId>
  <artifactId>webpninja-sdk</artifactId>
  <version>RELEASE</version>
</dependency>`,
    comingSoon: true,
    auth: `.header("Authorization", "Bearer webpninja_live_your_key")`,
    compress: `String boundary = "WebPNinjaBoundary" + System.currentTimeMillis();
byte[] fileBytes = Files.readAllBytes(Path.of("photo.png"));

var body = new StringBuilder();
body.append("--").append(boundary).append("\\r\\n");
body.append("Content-Disposition: form-data; name=\\"format\\"\\r\\n\\r\\nwebp\\r\\n");
body.append("--").append(boundary).append("\\r\\n");
body.append("Content-Disposition: form-data; name=\\"quality\\"\\r\\n\\r\\n75\\r\\n");
body.append("--").append(boundary).append("\\r\\n");
body.append("Content-Disposition: form-data; name=\\"file\\"; filename=\\"photo.png\\"\\r\\n");
body.append("Content-Type: image/png\\r\\n\\r\\n");

var out = new ByteArrayOutputStream();
out.write(body.toString().getBytes());
out.write(fileBytes);
out.write(("\\r\\n--" + boundary + "--\\r\\n").getBytes());

HttpClient client = HttpClient.newHttpClient();
HttpRequest request = HttpRequest.newBuilder()
    .uri(URI.create("https://api.webpninja.com/api/v1/compress"))
    .header("Authorization", "Bearer webpninja_live_your_key")
    .header("Content-Type", "multipart/form-data; boundary=" + boundary)
    .POST(HttpRequest.BodyPublishers.ofByteArray(out.toByteArray()))
    .build();

HttpResponse<byte[]> response = client.send(request, HttpResponse.BodyHandlers.ofByteArray());

if (response.statusCode() != 200) {
    throw new RuntimeException(new String(response.body()));
}

Files.write(Path.of("photo.webp"), response.body());`,
  },
  {
    key: 'dotnet',
    label: '.NET',
    install: `dotnet add package WebPNinja`,
    comingSoon: true,
    auth: `client.DefaultRequestHeaders.Authorization =
    new AuthenticationHeaderValue("Bearer", "webpninja_live_your_key");`,
    compress: `using var client = new HttpClient();
client.DefaultRequestHeaders.Authorization =
    new AuthenticationHeaderValue("Bearer", "webpninja_live_your_key");

using var content = new MultipartFormDataContent();
content.Add(new ByteArrayContent(await File.ReadAllBytesAsync("photo.png")), "file", "photo.png");
content.Add(new StringContent("webp"), "format");
content.Add(new StringContent("75"), "quality");

var response = await client.PostAsync("https://api.webpninja.com/api/v1/compress", content);
response.EnsureSuccessStatusCode();

await File.WriteAllBytesAsync("photo.webp", await response.Content.ReadAsByteArrayAsync());`,
  },
];
---

<Layout
  title="Developer API Docs — WebP Ninja"
  description="REST API reference for the WebP Ninja Developer API: authentication, endpoints, quotas, and example requests in HTTP, Node.js, Python, Ruby, PHP, Java, and .NET."
>
  <Nav />
  <main class="max-w-[760px] mx-auto px-6 py-24">
    <h1 class="text-[32px] font-semibold leading-[40px] tracking-[-1.28px] text-[#171717] mb-4">
      Developer API
    </h1>
    <p class="text-[16px] leading-[26px] text-[#4d4d4d] mb-8 max-w-[560px]">
      A REST API for server-side image compression — for automation, backends, and pipelines.
      This is a separate product from the free browser tool above: requests here are
      processed on our servers (in memory, never persisted to disk), gated by an API key
      tied to your plan. Get a key from the <a href="/dashboard" class="text-[#b45309] hover:underline">dashboard</a>.
    </p>

    <div class="mb-12">
      <p class="text-[12px] font-medium text-[#888888] mb-2">Select language</p>
      <div id="lang-picker" class="flex flex-wrap gap-1.5">
        {languages.map((lang, i) => (
          <button
            type="button"
            data-lang-btn={lang.key}
            class:list={[
              'px-3.5 h-8 text-[13px] font-medium rounded-full border transition-colors',
              i === 0
                ? 'bg-[#171717] text-white border-[#171717]'
                : 'bg-white text-[#4d4d4d] border-[#ebebeb] hover:bg-[#f5f5f5]',
            ]}
          >
            {lang.label}
          </button>
        ))}
      </div>
    </div>

    <div class="flex flex-col gap-10 text-[15px] leading-[24px] text-[#4d4d4d]">
      <section>
        <h2 class="text-[20px] font-semibold text-[#171717] mb-3">Installation</h2>
        {languages.map((lang, i) => (
          <div data-lang-panel={lang.key} hidden={i !== 0}>
            {lang.install ? (
              <>
                <pre class={codeBlock}>{lang.install}</pre>
                {(lang.sdkPublishing || lang.comingSoon) && (
                  <p class="text-[13px] text-[#b45309] mt-2">
                    🚧 Publishing soon — not yet live on {lang.key === 'node' ? 'npm' : lang.key === 'python' ? 'PyPI' : lang.key === 'ruby' ? 'RubyGems' : lang.key === 'php' ? 'Packagist' : lang.key === 'java' ? 'Maven Central' : 'NuGet'}.
                  </p>
                )}
              </>
            ) : (
              <p>No installation needed — call the REST endpoint directly with any HTTP client.</p>
            )}
          </div>
        ))}
      </section>

      <section>
        <h2 class="text-[20px] font-semibold text-[#171717] mb-3">Authentication</h2>
        <p class="mb-3">
          Pass your API key as a bearer token on every request:
        </p>
        {languages.map((lang, i) => (
          <pre data-lang-panel={lang.key} class={codeBlock} hidden={i !== 0}>{lang.auth}</pre>
        ))}
        <img
          src="/docs/postman-apikey.png"
          alt="Setting the Authorization header with a Bearer API key in Postman"
          class="mt-4 w-full rounded-[10px] border border-[#ebebeb]"
        />
      </section>

      <section>
        <h2 class="text-[20px] font-semibold text-[#171717] mb-3">Compress an image</h2>
        <p class="mb-3">
          <code class="font-mono text-[13px] bg-[#f5f5f5] px-1.5 py-0.5 rounded-[4px]">POST /api/v1/compress</code>
          — multipart form upload. Returns the compressed image bytes with the matching
          <code class="font-mono text-[13px] bg-[#f5f5f5] px-1.5 py-0.5 rounded-[4px]">Content-Type</code>.
        </p>
        <table class="w-full text-[13px] mb-4 border-collapse">
          <thead>
            <tr class="border-b border-[#ebebeb] text-left">
              <th class="py-2 pr-4 font-mono text-[11px] uppercase tracking-wider text-[#888888]">Field</th>
              <th class="py-2 font-mono text-[11px] uppercase tracking-wider text-[#888888]">Description</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-[#ebebeb]">
              <td class="py-2 pr-4 font-mono">file</td>
              <td class="py-2">The image to compress (multipart file field). Any format sharp can decode.</td>
            </tr>
            <tr class="border-b border-[#ebebeb]">
              <td class="py-2 pr-4 font-mono">format</td>
              <td class="py-2">Output format: <code class="font-mono">webp</code>, <code class="font-mono">jpeg</code>, <code class="font-mono">png</code>, or <code class="font-mono">avif</code>.</td>
            </tr>
            <tr>
              <td class="py-2 pr-4 font-mono">quality</td>
              <td class="py-2">10–100, default 80. Same compression settings as the browser tool at the same quality.</td>
            </tr>
          </tbody>
        </table>
        {languages.map((lang, i) => (
          <div data-lang-panel={lang.key} hidden={i !== 0}>
            {lang.comingSoon && (
              <p class="text-[13px] text-[#b45309] mb-2">
                Official {lang.label} SDK — coming soon. Here's how to call the API directly today:
              </p>
            )}
            {lang.sdkPublishing && (
              <p class="text-[13px] text-[#b45309] mb-2">
                This is the real {lang.label} SDK code — it'll work as soon as the package is published (see Installation above).
              </p>
            )}
            <pre class={codeBlock}>{lang.compress}</pre>
          </div>
        ))}
        <img
          src="/docs/postman-body.png"
          alt="Setting the file, format, and quality form-data fields in Postman"
          class="mt-4 w-full rounded-[10px] border border-[#ebebeb]"
        />
      </section>

      <section>
        <h2 class="text-[20px] font-semibold text-[#171717] mb-3">Quotas &amp; rate limits</h2>
        <p>
          <strong class="text-[#171717]">Free</strong> includes 15 compressions per day, resetting at
          midnight UTC, at up to 15 requests/min. <strong class="text-[#171717]">Starter</strong> and
          <strong class="text-[#171717]"> Pro</strong> have no compression quota — unlimited compressions,
          at up to 60 and 120 requests/min respectively. Exceeding a quota or rate limit returns
          <code class="font-mono text-[13px] bg-[#f5f5f5] px-1.5 py-0.5 rounded-[4px]"> 429 Too Many Requests</code>.
          See your current plan and usage on the <a href="/dashboard" class="text-[#b45309] hover:underline">dashboard</a>.
        </p>
      </section>

      <section>
        <h2 class="text-[20px] font-semibold text-[#171717] mb-3">Upload size limits</h2>
        <p>
          Each plan also caps the size of a single image: <strong class="text-[#171717]">Free — 15 MB</strong>,
          <strong class="text-[#171717]"> Starter — 33 MB</strong>, <strong class="text-[#171717]"> Pro — 200 MB</strong>.
          A file over your plan's limit returns <code class="font-mono text-[13px] bg-[#f5f5f5] px-1.5 py-0.5 rounded-[4px]">413 Payload Too Large</code>.
        </p>
      </section>

      <section>
        <h2 class="text-[20px] font-semibold text-[#171717] mb-3">Errors</h2>
        <table class="w-full text-[13px] border-collapse">
          <thead>
            <tr class="border-b border-[#ebebeb] text-left">
              <th class="py-2 pr-4 font-mono text-[11px] uppercase tracking-wider text-[#888888]">Status</th>
              <th class="py-2 font-mono text-[11px] uppercase tracking-wider text-[#888888]">Meaning</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-[#ebebeb]">
              <td class="py-2 pr-4 font-mono">400</td>
              <td class="py-2">Missing file, or an invalid format/quality value.</td>
            </tr>
            <tr class="border-b border-[#ebebeb]">
              <td class="py-2 pr-4 font-mono">401</td>
              <td class="py-2">Missing, invalid, or revoked API key.</td>
            </tr>
            <tr class="border-b border-[#ebebeb]">
              <td class="py-2 pr-4 font-mono">422</td>
              <td class="py-2">The file couldn't be decoded or compressed.</td>
            </tr>
            <tr class="border-b border-[#ebebeb]">
              <td class="py-2 pr-4 font-mono">413</td>
              <td class="py-2">File exceeds your plan's upload size limit.</td>
            </tr>
            <tr>
              <td class="py-2 pr-4 font-mono">429</td>
              <td class="py-2">Daily quota (Free plan) or rate limit exceeded.</td>
            </tr>
          </tbody>
        </table>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-lang-btn]');
  const panels = document.querySelectorAll<HTMLElement>('[data-lang-panel]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.dataset.langBtn;

      buttons.forEach((b) => {
        const active = b.dataset.langBtn === selected;
        b.classList.toggle('bg-[#171717]', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('border-[#171717]', active);
        b.classList.toggle('bg-white', !active);
        b.classList.toggle('text-[#4d4d4d]', !active);
        b.classList.toggle('border-[#ebebeb]', !active);
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.langPanel !== selected;
      });
    });
  });
</script>
