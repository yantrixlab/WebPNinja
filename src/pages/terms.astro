---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Terms of Service — WebP Ninja"
  description="The terms of service for using WebP Ninja's free, browser-based image compression tool."
>
  <Nav />
  <main class="max-w-[760px] mx-auto px-6 py-24">
    <h1 class="text-[32px] font-semibold leading-[40px] tracking-[-1.28px] text-[#171717] mb-8">
      Terms of Service
    </h1>
    <div class="text-[15px] leading-[24px] text-[#4d4d4d] flex flex-col gap-6">
      <section>
        <h2 class="text-[20px] font-semibold text-[#171717] mb-2">Use of Service</h2>
        <p>
          WebP Ninja is provided as a free, browser-based image compression tool.
          You may use it for personal or commercial purposes without restriction
          on the number or size of files processed.
        </p>
      </section>
      <section>
        <h2 class="text-[20px] font-semibold text-[#171717] mb-2">Acceptable Use</h2>
        <p>
          You agree not to use this service in any way that violates applicable
          laws or attempts to disrupt, overload, or compromise the site's
          availability for other users.
        </p>
      </section>
      <section>
        <h2 class="text-[20px] font-semibold text-[#171717] mb-2">No Warranty</h2>
        <p>
          This service is provided "as is," without warranties of any kind,
          express or implied, including but not limited to fitness for a
          particular purpose.
        </p>
      </section>
      <section>
        <h2 class="text-[20px] font-semibold text-[#171717] mb-2">Limitation of Liability</h2>
        <p>
          We are not liable for any loss or damage arising from your use of
          this service, including but not limited to loss of data or files
          processed using the tool.
        </p>
      </section>
      <section>
        <h2 class="text-[20px] font-semibold text-[#171717] mb-2">Governing Law</h2>
        <p>
          These terms are governed by the laws of India, without regard to
          conflict of law principles.
        </p>
      </section>
      <section>
        <h2 class="text-[20px] font-semibold text-[#171717] mb-2">Changes to These Terms</h2>
        <p>
          We may update these terms from time to time. Continued use of the
          site constitutes acceptance of any changes.
        </p>
      </section>
      <section>
        <h2 class="text-[20px] font-semibold text-[#171717] mb-2">Contact</h2>
        <p>
          Questions about these terms can be sent to
          <a href="mailto:hello@webpninja.com" class="text-[#b45309] hover:underline">hello@webpninja.com</a>.
        </p>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
