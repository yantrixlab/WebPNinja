---
import { faqs } from "../data/faq";
---

<section id="faq" class="bg-[#fafafa] py-24 px-6">
  <div class="max-w-[760px] mx-auto">

    <!-- Section header -->
    <div class="mb-12 text-center">
      <p class="font-mono text-[12px] text-[#888888] uppercase tracking-wider mb-4">
        # FAQ
      </p>
      <h2 class="text-[32px] font-semibold leading-[40px] tracking-[-1.28px] text-[#171717]">
        Common questions.
      </h2>
    </div>

    <!-- FAQ list -->
    <div class="flex flex-col divide-y divide-[#ebebeb]">
      {faqs.map((faq, i) => (
        <details class="group py-5 cursor-pointer list-none" name="faq">
          <summary class="flex items-center justify-between gap-4 text-[16px] font-medium text-[#171717] cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
            {faq.q}
            <span class="shrink-0 w-6 h-6 rounded-full border border-[#ebebeb] flex items-center justify-center transition-transform group-open:rotate-45">
              <svg width="12" height="12" fill="none" stroke="#171717" stroke-width="2" viewBox="0 0 24 24">
                <path d="M12 5v14M5 12h14"/>
              </svg>
            </span>
          </summary>
          <p class="mt-3 text-[15px] leading-[24px] text-[#4d4d4d]">
            {faq.a}
          </p>
        </details>
      ))}
    </div>

  </div>
</section>
