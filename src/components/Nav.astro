---
---
<header class="sticky top-0 z-50 bg-[#ffffff]/90 backdrop-blur-md border-b border-[#ebebeb]">
  <nav class="max-w-[1400px] mx-auto px-6 h-16 flex items-center justify-between gap-6">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 shrink-0" aria-label="WebP Ninja home">
      <img src="/favicon-96x96.png" width="28" height="28" alt="" class="w-7 h-7" />
      <span class="text-[14px] font-semibold tracking-[-0.28px] text-[#171717]">WebP Ninja</span>
    </a>

    <!-- Center nav links -->
    <div class="hidden md:flex items-center gap-1">
      <a href="#features" class="px-3 py-1.5 text-[14px] text-[#4d4d4d] hover:text-[#171717] rounded-full hover:bg-[#f5f5f5] transition-colors">Features</a>
      <a href="#how-it-works" class="px-3 py-1.5 text-[14px] text-[#4d4d4d] hover:text-[#171717] rounded-full hover:bg-[#f5f5f5] transition-colors">How it works</a>
      <a href="#faq" class="px-3 py-1.5 text-[14px] text-[#4d4d4d] hover:text-[#171717] rounded-full hover:bg-[#f5f5f5] transition-colors">FAQ</a>
      <a href="#wordpress-plugin" class="px-3 py-1.5 text-[14px] text-[#4d4d4d] hover:text-[#171717] rounded-full hover:bg-[#f5f5f5] transition-colors">WP Plugin</a>
      <a href="/docs" class="px-3 py-1.5 text-[14px] text-[#4d4d4d] hover:text-[#171717] rounded-full hover:bg-[#f5f5f5] transition-colors">Developer API</a>
    </div>

    <!-- Right CTA cluster -->
    <div class="flex items-center gap-2 shrink-0">
      <!-- "Free forever" badge -->
      <span class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1 text-[12px] font-medium text-[#7a4a00] bg-[#fef3d7] border border-[#f5e0a3] rounded-full">
        <span class="w-1.5 h-1.5 rounded-full bg-[#f5b400] animate-pulse"></span>
        Free forever
      </span>
      <a
        href="/dashboard"
        class="hidden sm:inline-flex items-center px-3 h-7 text-[13px] font-medium text-[#171717] bg-white border border-[#ebebeb] rounded-[6px] hover:bg-[#f5f5f5] transition-colors"
      >
        Dashboard
      </a>
      <a
        href="#compressor"
        class="inline-flex items-center gap-1.5 px-3 h-7 text-[13px] font-medium text-white bg-[#171717] rounded-[6px] hover:bg-[#333] transition-colors"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="#f5b400"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        Start compressing
      </a>
    </div>

  </nav>
</header>
