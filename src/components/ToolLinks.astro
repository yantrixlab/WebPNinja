---
import { tools, toolsBySlug, toolGroups, type ToolPage } from '../data/tools';

interface Props {
  heading?: string;
  eyebrow?: string;
  /** Show just these tools (in order) instead of every tool grouped. */
  slugs?: string[];
  id?: string;
  background?: string;
}

const {
  heading = 'Every image tool, one click away.',
  eyebrow = '# Tools',
  slugs,
  id = 'tools',
  background = '#ffffff',
} = Astro.props;

const groups: { label: string | null; items: ToolPage[] }[] = slugs
  ? [{ label: null, items: slugs.map((s) => toolsBySlug.get(s)).filter((t): t is ToolPage => !!t) }]
  : toolGroups.map((g) => ({ label: g.label, items: tools.filter((t) => t.category === g.category) }));
---

<section id={id} class="py-20 px-6" style={`background:${background}`}>
  <div class="max-w-[1100px] mx-auto">
    <div class="mb-10 text-center">
      <p class="font-mono text-[12px] text-[#888888] uppercase tracking-wider mb-4">{eyebrow}</p>
      <h2 class="text-[28px] sm:text-[32px] font-semibold leading-[40px] tracking-[-1.28px] text-[#171717]">{heading}</h2>
    </div>

    <div class="flex flex-col gap-10">
      {groups.map((group) => (
        <div>
          {group.label && (
            <p class="font-mono text-[11px] uppercase tracking-wider text-[#888888] mb-3">{group.label}</p>
          )}
          <ul class="grid gap-3 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
            {group.items.map((t) => (
              <li>
                <a
                  href={`/${t.slug}`}
                  class="group flex flex-col gap-1 h-full p-4 rounded-[12px] bg-white border border-[#ebebeb] hover:border-[#f5b400] hover:shadow-[0_4px_16px_rgba(245,180,0,0.12)] transition-all"
                >
                  <span class="flex items-center justify-between gap-2 text-[14px] font-semibold text-[#171717]">
                    {t.label}
                    <svg class="shrink-0 text-[#ccc] group-hover:text-[#d69400] group-hover:translate-x-0.5 transition-all" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </span>
                  <span class="text-[13px] leading-[20px] text-[#888]">{t.blurb}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
