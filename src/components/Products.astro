---
const products = [
  {
    icon: `<svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
    accent: "#f5b400",
    accentSoft: "#fef3d7",
    name: "Browser Compressor",
    tag: "Free forever",
    body: "Compress and convert PNG, JPEG, WebP, GIF, BMP and AVIF instantly, entirely in your browser. No upload, no limits, no sign-up.",
    cta: "Start compressing",
    href: "/#compressor",
  },
  {
    icon: `<svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M16 18l6-6-6-6M8 6l-6 6 6 6"/></svg>`,
    accent: "#171717",
    accentSoft: "#f0f0f0",
    name: "Developer API",
    tag: "Pay as you grow",
    body: "A REST API for server-side compression — automate image optimization from your own backend, scripts, or CI pipeline.",
    cta: "View API docs",
    href: "/docs",
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zM3.6 12c0-1.2.26-2.34.72-3.37L8.1 19.5A8.42 8.42 0 0 1 3.6 12zm8.4 8.4c-.82 0-1.6-.12-2.35-.33l2.5-7.26 2.55 7c.02.05.04.1.07.13A8.4 8.4 0 0 1 12 20.4zm1.16-12.55c.5-.03.96-.08.96-.08.45-.06.4-.72-.06-.69 0 0-1.35.11-2.22.11-.82 0-2.2-.11-2.2-.11-.46-.03-.51.65-.05.68 0 0 .43.05.89.08l1.32 3.6-1.85 5.55-3.08-9.16c.51-.02.96-.07.96-.07.45-.06.4-.72-.06-.69 0 0-1.35.11-2.22.11-.15 0-.33 0-.51-.01A8.4 8.4 0 0 1 12 3.6c2.2 0 4.2.84 5.7 2.22-.04 0-.07-.01-.11-.01-.82 0-1.4.71-1.4 1.48 0 .69.4 1.27.82 1.96.32.56.69 1.28.69 2.32 0 .72-.28 1.55-.64 2.71l-.84 2.8-3.06-9.13zM17.3 18.9l2.53-7.3c.47-1.18.63-2.12.63-2.96 0-.3-.02-.58-.06-.84A8.41 8.41 0 0 1 20.4 12a8.38 8.38 0 0 1-3.1 6.9z"/></svg>`,
    accent: "#4667de",
    accentSoft: "#eaeeff",
    name: "WordPress Plugin",
    tag: "Free · v1.0.0",
    body: "Auto-compress every image the moment it's uploaded to your WordPress Media Library — no API key, no external calls, all on your own server.",
    cta: "Download plugin",
    href: "/#wordpress-plugin",
  },
];
---

<section id="products" class="bg-white py-24 px-6 border-t border-[#ebebeb]">
  <div class="max-w-[1100px] mx-auto">

    <!-- Section header -->
    <div class="mb-14 flex flex-col items-center text-center">
      <p class="font-mono text-[12px] text-[#888888] uppercase tracking-wider mb-4">
        # Our Products
      </p>
      <h2 class="text-[32px] font-semibold leading-[40px] tracking-[-1.28px] text-[#171717] max-w-[600px]">
        One tool. One API. One plugin.
      </h2>
      <p class="mt-4 text-[16px] leading-[24px] text-[#4d4d4d] max-w-[480px]">
        Compress images wherever you work — in the browser, from your backend, or straight from WordPress.
      </p>
    </div>

    <!-- Product cards -->
    <div class="grid gap-6 sm:grid-cols-3">
      {products.map((p) => (
        <a
          href={p.href}
          class="group flex flex-col gap-4 p-6 rounded-[16px] bg-white border border-[#ebebeb] hover:border-[#d8d8d8] transition-all hover:-translate-y-0.5"
          style="box-shadow:0 1px 2px rgba(0,0,0,0.03)"
        >
          <div
            class="w-10 h-10 rounded-[10px] flex items-center justify-center"
            style={`background:${p.accentSoft}; color:${p.accent}`}
          >
            <Fragment set:html={p.icon} />
          </div>
          <div class="flex flex-col gap-1.5">
            <p class="text-[16px] font-semibold text-[#171717]">{p.name}</p>
            <span
              class="w-fit text-[11px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full"
              style={`background:${p.accentSoft}; color:${p.accent}`}
            >
              {p.tag}
            </span>
          </div>
          <p class="text-[14px] leading-[22px] text-[#4d4d4d] flex-1">{p.body}</p>
          <span class="inline-flex items-center gap-1.5 text-[13px] font-semibold" style={`color:${p.accent}`}>
            {p.cta}
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" class="transition-transform group-hover:translate-x-0.5">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </span>
        </a>
      ))}
    </div>

  </div>
</section>
