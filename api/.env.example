# Copy this to .env on your VPS and fill in the values
DATABASE_URL=postgres://username:password@localhost:5432/dbname
PORT=3001
ALLOWED_ORIGIN=https://webpninja.com

# Google Identity Services client ID (Cloud Console > Credentials > OAuth client ID).
# Only the client ID is needed — no client secret for the ID-token sign-in flow.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Secret used to sign dashboard session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Secret used to encrypt stored API keys so the dashboard can reveal the full
# key again later (not just its prefix). Generate with the same command as
# JWT_SECRET above. Losing/rotating this makes all previously-generated keys
# un-revealable (they still work for auth — only the reveal feature breaks).
API_KEY_ENCRYPTION_SECRET=

# Razorpay Dashboard > API Keys / > Webhooks
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
